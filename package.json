{
  "name": "@ivni/project-foundation",
  "version": "1.5.0",
  "description": "Interactive Bun installer for the Project Foundation agent skill suite.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivni/project-foundation.git"
  },
  "homepage": "https://github.com/ivni/project-foundation#readme",
  "bugs": {
    "url": "https://github.com/ivni/project-foundation/issues"
  },
  "keywords": [
    "agent-skills",
    "bun",
    "claude-code",
    "codex",
    "hermes-agent",
    "opencode",
    "pi-coding-agent"
  ],
  "bin": {
    "project-foundation": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "packages/*/SKILL.md",
    "packages/*/agents/**",
    "packages/*/assets/**",
    "packages/*/references/**",
    "packages/*/scripts/**",
    "packages/*/templates/**",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun build ./packages/cli/src/index.ts --target=bun --outdir=./dist --entry-naming=cli.js --sourcemap=external",
    "check": "bun run lint && bun run typecheck && bun test && bun run build && bun run verify:skills && bun run verify:docs && bun run verify:package",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "start": "bun ./packages/cli/src/index.ts",
    "sync:shared": "bun ./scripts/sync-shared.ts",
    "typecheck": "tsc --noEmit",
    "verify:docs": "bun ./scripts/verify-docs.ts",
    "verify:skills": "bun ./scripts/verify-skills.ts",
    "verify:package": "bun ./scripts/verify-package.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@clack/core": "^1.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
